<?xml version="1.0" encoding="UTF-8"?><ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="DarouichTravaux.Maui.Views.DashboardPage" Title="Tableau de bord"><ScrollView><VerticalStackLayout Padding="32" Spacing="24"><Label Text="Tableau de bord" FontSize="30" FontAttributes="Bold" TextColor="#103B2E"/><FlexLayout Wrap="Wrap" JustifyContent="Start"><Border StyleId="Card"><VerticalStackLayout><Label Text="Total facturé"/><Label Text="{Binding Data.Invoiced, StringFormat='{0:N2} DH'}" FontSize="24" FontAttributes="Bold"/></VerticalStackLayout></Border><Border StyleId="Card"><VerticalStackLayout><Label Text="Total encaissé"/><Label Text="{Binding Data.Collected, StringFormat='{0:N2} DH'}" FontSize="24" FontAttributes="Bold"/></VerticalStackLayout></Border><Border StyleId="Card"><VerticalStackLayout><Label Text="Reste à encaisser"/><Label Text="{Binding Data.Outstanding, StringFormat='{0:N2} DH'}" FontSize="24" FontAttributes="Bold"/></VerticalStackLayout></Border><Border StyleId="Card"><VerticalStackLayout><Label Text="Marge estimée"/><Label Text="{Binding Data.Margin, StringFormat='{0:N2} DH'}" FontSize="24" FontAttributes="Bold"/></VerticalStackLayout></Border></FlexLayout></VerticalStackLayout></ScrollView></ContentPage>
