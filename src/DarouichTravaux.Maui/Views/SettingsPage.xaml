<?xml version="1.0" encoding="UTF-8"?><ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="DarouichTravaux.Maui.Views.SettingsPage" Title="Paramètres"><ScrollView><VerticalStackLayout Padding="32" Spacing="14" MaximumWidthRequest="720" HorizontalOptions="Start"><Label Text="Paramètres" FontSize="30" FontAttributes="Bold"/><Label Text="Sauvegarde" FontSize="22" FontAttributes="Bold" Margin="0,20,0,0"/><HorizontalStackLayout Spacing="10"><Button Text="Créer une sauvegarde" Command="{Binding BackupCommand}"/><Button Text="Restaurer une sauvegarde" Command="{Binding RestoreCommand}"/><Button Text="Ouvrir le dossier" Command="{Binding OpenBackupFolderCommand}"/></HorizontalStackLayout><Label Text="Sécurité" FontSize="22" FontAttributes="Bold" Margin="0,24,0,0"/><Entry Placeholder="Mot de passe actuel" Text="{Binding CurrentPassword}" IsPassword="True"/><Entry Placeholder="Nouveau mot de passe" Text="{Binding NewPassword}" IsPassword="True"/><Entry Placeholder="Confirmer" Text="{Binding Confirmation}" IsPassword="True"/><HorizontalStackLayout Spacing="10"><Button Text="Changer le mot de passe" Command="{Binding ChangePasswordCommand}"/><Button Text="Se déconnecter" Command="{Binding LogoutCommand}" BackgroundColor="#8D2D2D"/></HorizontalStackLayout><Label Text="{Binding Status}" TextColor="#145A41"/></VerticalStackLayout></ScrollView></ContentPage>
