<?xml version="1.0" encoding="UTF-8"?><ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="DarouichTravaux.Maui.Views.ClientsPage" Title="Clients"><Grid Padding="32" RowDefinitions="Auto,*"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><SearchBar Placeholder="Rechercher un client" Text="{Binding Search}" SearchCommand="{Binding LoadCommand}"/><Button Grid.Column="1" Text="Nouveau client" Command="{Binding AddCommand}"/></Grid><CollectionView Grid.Row="1" ItemsSource="{Binding Clients}" Margin="0,20"><CollectionView.ItemTemplate><DataTemplate><Border Margin="0,5" Padding="16" Stroke="#DDE5E1"><Grid ColumnDefinitions="2*,*,*"><Label Text="{Binding Name}" FontAttributes="Bold"/><Label Grid.Column="1" Text="{Binding Phone}"/><Label Grid.Column="2" Text="{Binding City}"/></Grid></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView></Grid></ContentPage>
