<?xml version="1.0" encoding="UTF-8"?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:DarouichTravaux.Maui.Views"
       x:Class="DarouichTravaux.Maui.AppShell"
       FlyoutBehavior="Flyout"
       FlyoutBackgroundColor="#103B2E"
       FlyoutForegroundColor="White"
       Title="Darouich Travaux">
    <FlyoutItem Title="Tableau de bord" Route="dashboard">
        <ShellContent ContentTemplate="{DataTemplate views:DashboardPage}" />
    </FlyoutItem>
    <FlyoutItem Title="Clients" Route="clients">
        <ShellContent ContentTemplate="{DataTemplate views:ClientsPage}" />
    </FlyoutItem>
    <FlyoutItem Title="Paramètres" Route="settings">
        <ShellContent ContentTemplate="{DataTemplate views:SettingsPage}" />
    </FlyoutItem>
</Shell>
